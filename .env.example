# ============================================================
# StudyMoon — example environment file
# Copy to .env.local (local dev) and fill every value.
# NEVER commit real keys. Production values live in Vercel/GitHub Secrets.
# Full step-by-step: see docs/SETUP.md
# ============================================================

# --- Supabase (Dashboard -> Project Settings -> Data API) ---
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# "Publishable key" (new name for the old anon key), starts with sb_publishable_
SUPABASE_ANON_KEY=
# "Secret key" (server-side only, replaces service_role), starts with sb_secret_
SUPABASE_SECRET_KEY=

# --- Database direct connection (Dashboard -> Project Settings -> Database) ---
# Used by scripts: migrations, seed, RLS tests, nightly backup.
# Session pooler URI (port 5432) recommended for scripts.
DATABASE_URL=

# --- AI providers (router fallback order: Gemini -> Groq -> Cerebras -> OpenRouter) ---
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free flash model currently available (check aistudio for the latest name)
GEMINI_MODEL=gemini-3.8-flash
# Groq (optional fallback): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Cerebras (optional fallback): https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
# OpenRouter (optional fallback, models ending in :free): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Web Push notifications (run: pnpm generate:vapid) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Scheduler ---
# Random hex secret that protects /api/cron/* routes (openssl rand -hex 24)
CRON_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
